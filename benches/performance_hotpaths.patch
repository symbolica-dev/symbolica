+            parse!("x^(3*a+3*b)+3*x^(2*a+2*b)*y+3*x^(a+b)*y^2+y^3")
+        );
+        assert_eq!(
+            parse!("(x+y+z)^3").expand_in(symbol!("x")),
+            parse!("x^3+3*x^2*(y+z)+3*x*(y+z)^2+(y+z)^3")
+        );
+        assert_eq!(
+            parse!("(2*x-3*y+5)^-4").expand(),
+            parse!("(2*x-3*y+5)^4").expand().pow(-1)
