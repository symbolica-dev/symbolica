+    #[test]
+    fn multinomial_coefficients_normalize_with_their_terms() {
+        use crate::atom::Atom;
+
+        for input in [
+            "(2*x-3*y+5*z+7)^6",
+            "(x/2-2*y/3+5)^5",
+            "(x+x^2+y)^5",
